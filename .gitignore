# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Kivy / buildozer (Android packaging)
.buildozer/
bin/
*.apk
*.aab

# Keystore files — never commit signing material or credentials
*.jks
*.keystore
keystore.properties

# Log files
*.log

# macOS / Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Finder duplicates ("config 2.yml", "config copy.yml"). Two of these
# were committed by accident before this rule existed.
* [0-9].*
* copy.*
* copy [0-9].*

# IDE / AI tool state
.idea/
.vscode/
.cursor/
.claude/

# Temporary files
*.tmp
*.temp
.git_backup/
.git.backup*/
