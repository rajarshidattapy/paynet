<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/scanner_scrim" android:importantForAccessibility="no" />

    <!-- Scanner Frame: four rounded corner brackets -->
    <FrameLayout
        android:id="@+id/scannerOverlay"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:rotation="0"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|end"
            android:rotation="90"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:rotation="180"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:rotation="270"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <!-- Kept for code refs; not shown in the minimal design -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:visibility="gone"
            android:background="@drawable/scan_line_gradient" />

    </FrameLayout>

    <!-- Torch button (bottom center) -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_flash_off"
            android:scaleType="centerInside"
            android:padding="20dp"
            android:contentDescription="@string/qr_torch"
            app:tint="@color/white" />

        <!-- Same 64dp box, same background and padding as the torch so the
             pair reads as one symmetric group centred on the screen. -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerInside"
            android:padding="20dp"
            android:contentDescription="@string/qr_pick_from_gallery"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Web scanner: small close control at the top-right. -->
    <FrameLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="48dp"
        android:layout_marginHorizontal="20dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="end" android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_close" android:scaleType="centerInside" android:padding="15dp"
            android:contentDescription="@string/qr_close_scanner" app:tint="@color/white" />
    </FrameLayout>

    <!-- Hidden: Instructions Box — shown on black screen after QR scan -->
    <FrameLayout
        android:id="@+id/instructionsBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="190dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/instructions_card_bg"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/instructionsHeaderInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/qr_steps_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/instructionsExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/qr_step_paste_vpa"
                android:textSize="15sp" android:textColor="@color/divider_dark"
                android:lineSpacingExtra="2dp" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/qr_step_enter_amount"
                android:textSize="15sp" android:textColor="@color/divider_dark"
                android:lineSpacingExtra="2dp" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/qr_step_press_one"
                android:textSize="15sp" android:textColor="@color/divider_dark"
                android:lineSpacingExtra="2dp" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/qr_step_enter_pin"
                android:textSize="15sp" android:textColor="@color/divider_dark"
                android:lineSpacingExtra="2dp" android:layout_marginBottom="10dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/qr_step_press_cancel"
                android:textSize="15sp" android:textColor="@color/divider_dark"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Hidden: Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Invalid-scan banner: sits OVER the live preview so a bad QR never
         blanks the camera. Auto-hides and scanning continues. -->
    <TextView
        android:id="@+id/tvScanError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/scan_error_banner_bg"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="6dp"
        android:fontFamily="sans-serif"
        android:accessibilityLiveRegion="polite"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden: Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:gravity="center"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/instructionsBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:id="@+id/qrOutcomePanel" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp" android:layout_marginBottom="20dp" android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvStatus" app:layout_constraintBottom_toTopOf="@id/btnTerminate"
        app:layout_constraintVertical_bias="0.35" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/qr_payment_outcome_title"
            android:fontFamily="sans-serif-medium" android:textSize="22sp" android:textColor="@color/white" android:gravity="center" android:accessibilityHeading="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/qr_payment_outcome_hint"
            android:layout_marginTop="10dp" android:layout_marginBottom="24dp" android:textSize="14sp" android:lineSpacingExtra="3dp"
            android:textColor="@color/payment_body" android:gravity="center"/>
        <include layout="@layout/payment_outcome_buttons" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/qrOutcomeError" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:visibility="gone" android:text="@string/payment_save_error" android:textColor="@color/payment_body"
            android:textSize="13sp" android:gravity="center" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>

    <!-- Hidden: Terminate Button -->
    <ImageButton
        android:id="@+id/btnTerminate"
        android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/qr_close_circle" android:src="@drawable/ic_close"
        android:padding="13dp" android:scaleType="fitCenter"
        android:visibility="gone" android:layout_marginBottom="56dp"
        android:contentDescription="@string/manual_return_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
