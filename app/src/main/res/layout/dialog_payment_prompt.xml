<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/payment_dialog_background" android:overScrollMode="never" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="24dp" android:paddingTop="26dp" android:paddingBottom="10dp" android:gravity="center_horizontal">
        <ImageView android:id="@+id/paymentPromptIcon" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginBottom="16dp" android:padding="12dp"
            android:background="@drawable/payment_prompt_icon_background" android:src="@drawable/ic_payment_receipt" android:contentDescription="@null"/>
        <TextView android:id="@+id/paymentPromptTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="20sp" android:textColor="@color/white" android:gravity="center"
            android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:accessibilityHeading="true"/>
        <TextView android:id="@+id/paymentPromptBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:textSize="14sp" android:textColor="@color/payment_body"
            android:gravity="center" android:lineSpacingExtra="4dp"/>
        <include android:id="@+id/paymentPromptAnswers" layout="@layout/payment_outcome_buttons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"/>
        <TextView android:id="@+id/paymentPromptLater" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp"
            android:text="@string/payment_answer_later" android:gravity="center" android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"/>
        <TextView android:id="@+id/paymentPromptError" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:text="@string/payment_save_error" android:textSize="13sp" android:textColor="@color/payment_body"
            android:gravity="center" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
</ScrollView>