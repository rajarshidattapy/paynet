<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
    <com.paynet.app.ui.components.PaymentAnswerButton android:id="@+id/paymentAnswerNo" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_weight="1"
        android:layout_marginEnd="5dp" android:background="@drawable/payment_answer_no" android:orientation="horizontal"
        android:paddingHorizontal="12dp" android:paddingVertical="12dp" android:gravity="center" android:clickable="true" android:focusable="true"
        android:contentDescription="@string/payment_answer_no">
        <ImageView android:id="@+id/paymentNoIcon" android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_payment_no" android:contentDescription="@null" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/payment_answer_no" android:fontFamily="sans-serif-medium" android:textSize="15sp"
            android:textColor="@color/white" android:includeFontPadding="false" android:importantForAccessibility="no"/>
    </com.paynet.app.ui.components.PaymentAnswerButton>
    <com.paynet.app.ui.components.PaymentAnswerButton android:id="@+id/paymentAnswerYes" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_weight="1"
        android:layout_marginStart="5dp" android:background="@drawable/payment_answer_yes" android:orientation="horizontal"
        android:paddingHorizontal="12dp" android:paddingVertical="12dp" android:gravity="center" android:clickable="true" android:focusable="true"
        android:contentDescription="@string/payment_answer_yes">
        <ImageView android:id="@+id/paymentYesIcon" android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_payment_yes" android:contentDescription="@null" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/payment_answer_yes" android:fontFamily="sans-serif-medium" android:textSize="15sp"
            android:textColor="@color/white" android:includeFontPadding="false" android:importantForAccessibility="no"/>
    </com.paynet.app.ui.components.PaymentAnswerButton>
</LinearLayout>
